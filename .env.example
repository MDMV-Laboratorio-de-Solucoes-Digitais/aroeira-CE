# Aroeira Template - Development Environment Variables
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env with real credentials!

# PostgreSQL MCP Server Configuration
# Used by AI tools (Gemini CLI, Kilocode, etc.) to connect to your local database
# Replace <USERNAME>, <PASSWORD>, <HOST>, <PORT>, and <DATABASE> with your values
AROEIRA_DATABASE_URI=postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>

# SQLite MCP Server Configuration
# Path to the local SQLite database used by the desktop app (relative to project root)
AROEIRA_SQLITE_PATH=apps/desktop/src-tauri/aroeira.db

# =============================================================================
# OAuth Configuration (Desktop App)
# =============================================================================

# Google OAuth - PKCE-only (safe for desktop clients)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub OAuth - IMPORTANT: Security Configuration
# ⚠️ PRODUCTION: DO NOT use GITHUB_CLIENT_SECRET in desktop binary!
# GitHub OAuth requires BFF proxy in production to avoid embedding client_secret.
GITHUB_CLIENT_ID=your-github-client-id

# Development ONLY: allows using client_secret locally
# ⚠️ NEVER commit or embed in release builds!
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Production (REQUIRED for GitHub OAuth in production)
# The BFF proxy keeps client_secret on the server, not in the desktop client.
# Option 1: Set GITHUB_TOKEN_URL directly (full URL to proxy endpoint)
# GITHUB_TOKEN_URL=https://auth.your-domain.com/oauth/github/token
# Option 2: Set AUTH_PROXY_URL (base URL, will derive token URL as {base}/oauth/github/token)
# AUTH_PROXY_URL=https://auth.your-domain.com
